# Flask Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
DATABASE_URL=sqlite:///outbound_omega.db

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Zoho Email Configuration
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_USERNAME=your-zoho-email@yourdomain.com
ZOHO_PASSWORD=your-zoho-password

# Sending Limits
MAX_EMAILS_PER_DAY=50

# CAN-SPAM Compliance
PHYSICAL_ADDRESS=123 Business St, Suite 100, Atlanta, GA 30303
UNSUBSCRIBE_BASE_URL=http://localhost:5000/unsubscribe
COMPANY_NAME=Your Company Name

# From Addresses (comma-separated)
FROM_ADDRESSES=outreach@yourcompany.com,hello@yourcompany.com

# Scraper Endpoint
SCRAPER_ENDPOINT=http://localhost:5000/scrape
